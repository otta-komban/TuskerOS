{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/theme-preview-render-request-1.0.0.json",
  "title": "TuskerOS Theme Preview Render Request",
  "description": "Inert, owner-authorized preview data for a negotiated desktop adapter. This request MUST NOT apply or persist settings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "session_id", "revision", "preview_only", "expires_in_ms", "surfaces", "snapshot"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "revision": {"type": "integer", "minimum": 0},
    "preview_only": {"const": true},
    "expires_in_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
    "surfaces": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"enum": ["desktop", "panel", "dock", "launcher", "notifications", "lock_screen", "window_decorations", "widgets", "settings", "quick_settings"]}},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "theme_id", "theme_version", "tokens", "assets", "accessibility"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "theme_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "theme_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
        "tokens": {"type": "object", "minProperties": 1, "maxProperties": 9, "propertyNames": {"enum": ["color", "typography", "spacing", "shape", "shadow", "motion", "surface", "asset", "provenance"]}, "additionalProperties": {"$ref": "#/$defs/tokenValue"}},
        "assets": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["asset_id", "kind"], "properties": {"asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}, "kind": {"enum": ["wallpaper", "icon", "font", "sound", "illustration"]}}}},
        "accessibility": {"type": "object", "additionalProperties": false, "required": ["focus_indicator", "reduced_motion", "minimum_text_scale"], "properties": {"focus_indicator": {"const": true}, "reduced_motion": {"type": "boolean"}, "minimum_text_scale": {"type": "number", "minimum": 1, "maximum": 2}, "high_contrast": {"type": "boolean"}}}
      }
    },
    "tokenValue": {
      "oneOf": [
        {"type": ["string", "number", "boolean"], "maxLength": 256},
        {"type": "object", "maxProperties": 128, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "additionalProperties": {"type": ["string", "number", "boolean"], "maxLength": 256}}
      ]
    }
  }
}
