{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tuskeros.invalid/core/plan-0.1.0-draft.json",
  "title": "Tusker Core Plan (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "created_at",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "sequence",
          "operation_id",
          "input",
          "depends_on",
          "timeout_ms",
          "state"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$"
          },
          "input": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected_postconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "risk_hint": {
            "type": "string",
            "maxLength": 64,
            "description": "Untrusted advisory only; never authorizes or determines policy risk."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000,
            "description": "Core ceiling aligned to current NEXUS invocation deadline maximum; use the lower descriptor/provider maximum."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "minLength": 16,
            "description": "When present, must meet the NEXUS invocation contract's 16-128 character bounds. Every mutating operation requires a non-null key; mutation eligibility is enforced by the descriptor-aware adapter, not this shape schema."
          },
          "state": {
            "enum": [
              "pending",
              "ready",
              "running",
              "awaiting_approval",
              "succeeded",
              "failed",
              "cancelled",
              "skipped",
              "unknown_outcome"
            ]
          }
        }
      }
    },
    "requires_confirmation": {
      "type": "boolean"
    }
  }
}
