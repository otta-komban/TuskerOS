{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tuskeros.invalid/core/task-result-0.1.0-draft.json",
  "title": "Tusker Core Task Result (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "final_state",
    "summary",
    "completed_steps",
    "failed_steps",
    "skipped_steps",
    "verification",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "final_state": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "partially_completed"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "failed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "skipped_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
