{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/action-proposal-0.1.0.json",
  "title": "TuskerOS Action Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "proposal_id",
    "task_id",
    "step_id",
    "arguments",
    "resources",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "arguments": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "access"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "access": {
            "enum": [
              "read",
              "create",
              "modify",
              "delete",
              "execute",
              "administer"
            ]
          }
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
