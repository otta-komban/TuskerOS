{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/policy-decision-0.1.0.json",
  "title": "TuskerOS Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "proposal_id",
    "decision",
    "reason_code",
    "risk_class",
    "policy_version",
    "action_digest",
    "principal_binding",
    "evaluated_at",
    "constraints",
    "expires_at",
    "approval_request_id",
    "authorization_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "DENY",
        "REQUIRE_APPROVAL",
        "ALLOW"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "principal_binding": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approval_request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "constraints": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "authorization_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REQUIRE_APPROVAL"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "approval_request_id"
        ],
        "properties": {
          "approval_request_id": {
            "type": "string",
            "format": "uuid"
          },
          "authorization_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ALLOW"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "expires_at",
          "authorization_ref"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "DENY"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "type": "null"
          },
          "approval_request_id": {
            "type": "null"
          },
          "authorization_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
