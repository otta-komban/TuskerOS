{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/approval-request-0.2.0.json",
  "title": "TuskerOS Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_request_id",
    "proposal_id",
    "action_id",
    "action_digest",
    "principal_binding",
    "binding",
    "policy_version",
    "risk_class",
    "summary",
    "target",
    "impact",
    "reversible",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "approval_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "action_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "principal_binding": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_binding",
        "device_binding",
        "registry_version",
        "resource_scope",
        "precondition_digest"
      ],
      "properties": {
        "session_binding": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "device_binding": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "registry_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "precondition_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "reversible": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
