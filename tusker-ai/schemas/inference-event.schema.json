{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/inference-event.schema.json",
  "title": "Tusker Inference Event",
  "description": "Provider-neutral event envelope. Tool-call fragments and provider text are untrusted data; this schema does not authorize execution.",
  "oneOf": [
    {
      "$ref": "#/$defs/started"
    },
    {
      "$ref": "#/$defs/text_delta"
    },
    {
      "$ref": "#/$defs/tool_call_delta"
    },
    {
      "$ref": "#/$defs/usage"
    },
    {
      "$ref": "#/$defs/resource"
    },
    {
      "$ref": "#/$defs/completed"
    },
    {
      "$ref": "#/$defs/cancelled"
    },
    {
      "$ref": "#/$defs/failed"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "request_id",
        "sequence",
        "timestamp",
        "type"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "started": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "started"
            },
            "provider_id": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider_id",
            "model_id"
          ]
        }
      ]
    },
    "text_delta": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "text_delta"
            },
            "delta": {
              "type": "string"
            }
          },
          "required": [
            "delta"
          ]
        }
      ]
    },
    "tool_call_delta": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "tool_call_delta"
            },
            "call_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "arguments_fragment": {
              "type": "string"
            },
            "is_final": {
              "type": "boolean"
            }
          },
          "required": [
            "call_id",
            "name",
            "arguments_fragment",
            "is_final"
          ]
        }
      ]
    },
    "usage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "usage"
            },
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "resource": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "resource"
            },
            "memory_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "gpu_memory_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sample_source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "sample_source"
          ]
        }
      ]
    },
    "completed": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "completed"
            },
            "finish_reason": {
              "enum": [
                "stop",
                "output_limit",
                "tool_calls",
                "provider_specific",
                "unknown"
              ]
            }
          }
        }
      ]
    },
    "cancelled": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "cancelled"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    },
    "failed": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "properties": {
            "type": {
              "const": "failed"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ]
        }
      ]
    }
  }
}
