{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tuskeros.invalid/system-integration/health-status-1.0.schema.json",
  "title": "TuskerOS Component Health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "version",
    "state",
    "checked_at",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "enum": [
        "starting",
        "ready",
        "degraded",
        "stopping",
        "failed"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_successful_operation_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "contract_major_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "enum": [
              "ready",
              "degraded",
              "unavailable",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
