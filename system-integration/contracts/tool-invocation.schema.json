{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tuskeros.invalid/system-integration/tool-invocation-1.0.schema.json",
  "title": "TuskerOS Tool Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "caller",
    "tool",
    "arguments",
    "deadline_ms",
    "task_id",
    "step_id",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "instance_id"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "arguments": {
      "type": "object"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "cancellation_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorization_context": {
      "type": "object",
      "description": "Opaque trusted authorization context injected/validated by the trusted IPC/broker boundary; exact AEGIS-06-owned shape is pending. Never accept caller-supplied identity or decision claims as authoritative.",
      "additionalProperties": true
    }
  }
}
