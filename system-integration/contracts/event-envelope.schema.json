{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tuskeros.invalid/system-integration/event-envelope-1.0.schema.json",
  "title": "TuskerOS Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "correlation_id",
    "subject_id",
    "sequence",
    "payload"
  ],
  "properties": {
    "event_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  }
}
