{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/release-validation-report.schema.json",
  "title": "TuskerOS Release Validation Report",
  "description": "Machine-readable record of checks performed against one immutable release-manifest subject. This schema records evidence; it does not itself establish trust or authorize promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "report_id",
    "subject",
    "validator",
    "started_at_utc",
    "finished_at_utc",
    "overall_status",
    "summary",
    "checks"
  ],
  "properties": {
    "report_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "overall_status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "incomplete"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "execution_environment": {
      "$ref": "#/$defs/environment"
    },
    "policy_reference": {
      "$ref": "#/$defs/evidence"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "release_id"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "blocked",
        "not_run"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "category",
        "status",
        "subject_digest",
        "message"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "schema",
            "semantic",
            "artifact",
            "provenance",
            "signature",
            "test_evidence",
            "staging",
            "policy",
            "other"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run"
          ]
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "finished_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64",
            "other"
          ]
        },
        "runner_id": {
          "type": "string",
          "minLength": 1
        },
        "ci_run_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
