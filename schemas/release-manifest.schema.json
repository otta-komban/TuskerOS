{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuskeros.dev/schemas/release-manifest.schema.json",
  "title": "TuskerOS Release Manifest",
  "description": "Structural schema for a TuskerOS release candidate. Promotion policy, signature verification and test-gate evaluation remain separate responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "channel",
    "created_at_utc",
    "source",
    "recipe",
    "platform",
    "repositories",
    "packages",
    "sbom",
    "provenance",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "development",
        "testing",
        "stable"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC RFC 3339 timestamp; producers must use the Z suffix."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "sbom": {
      "$ref": "#/$defs/evidenceReference"
    },
    "provenance": {
      "$ref": "#/$defs/evidenceReference"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "source": {
      "$ref": "#/$defs/gitSource"
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "release",
        "architecture",
        "builder",
        "environment_digest"
      ],
      "properties": {
        "distribution": {
          "const": "Fedora"
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "snapshot_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nevra"
      ],
      "properties": {
        "nevra": {
          "type": "string",
          "minLength": 1,
          "description": "Exact resolved RPM name-epoch:version-release.arch string."
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "uri",
        "sha256"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_tested"
          ]
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "media_type",
        "architecture",
        "firmware_targets",
        "size_bytes",
        "sha256",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "firmware_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "uefi",
              "bios"
            ]
          },
          "uniqueItems": true
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "$ref": "#/$defs/evidenceReference"
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uefi_boot",
            "secure_boot",
            "desktop_smoke",
            "install",
            "recovery"
          ],
          "properties": {
            "uefi_boot": {
              "$ref": "#/$defs/testResult"
            },
            "secure_boot": {
              "$ref": "#/$defs/testResult"
            },
            "desktop_smoke": {
              "$ref": "#/$defs/testResult"
            },
            "install": {
              "$ref": "#/$defs/testResult"
            },
            "recovery": {
              "$ref": "#/$defs/testResult"
            }
          }
        }
      }
    }
  }
}
