{
  "schema_version": "1.0.0",
  "id": "tusker.smooth-ui",
  "version": "0.1.0",
  "metadata": {
    "name": "Smooth UI",
    "description": "Soft tonal surfaces, rounded geometry and clear semantic color roles.",
    "author": "TuskerOS",
    "license": "Apache-2.0"
  },
  "compatibility": { "theme_engine_api": "1.0", "desktop": ["KDE Plasma"], "required_surfaces": ["desktop", "panel", "launcher"] },
  "tokens": {
    "colors": {
      "background": "#F4F1F8", "surface": "#FFFFFF", "surface_alt": "#EAE5F1",
      "foreground": "#211D29", "muted": "#625D6B", "accent": "#6750A4",
      "accent_foreground": "#FFFFFF", "border": "#CAC3D4", "focus": "#59418F",
      "success": "#286B45", "warning": "#805900", "danger": "#A33232"
    },
    "typography": { "family": "Noto Sans", "size_base": 14, "weight_normal": 400, "weight_emphasis": 600, "line_height": 1.45 },
    "spacing": { "unit": "px", "compact": 5, "normal": 10, "comfortable": 18 },
    "shape": { "radius_small": 8, "radius_medium": 14, "radius_large": 24 },
    "shadow": { "enabled": true, "blur": 16, "opacity": 0.14, "y_offset": 4 },
    "motion": { "enabled": true, "duration_ms": 160, "reduced_motion_compatible": true }
  },
  "accessibility": { "minimum_text_scale": 1, "focus_indicator": true, "high_contrast_variant": true, "reduced_motion": true },
  "assets": []
}
